new file mode 100644
index 0000000..42bf4e7
--- /dev/null
+++ b/src/libhydrogen/impl/random/switch.h
@@ -0,0 +1,13 @@
+/* Nintendo Switch (libnx): kernel entropy via randomGet(). */
+#include <stddef.h>
+
+void randomGet(void *buf, size_t len);
+
+static int
+hydro_random_init(void)
+{
+    randomGet(hydro_random_context.state, sizeof hydro_random_context.state);
+    hydro_random_context.counter = ~LOAD64_LE(hydro_random_context.state);
+
+    return 0;
+}
