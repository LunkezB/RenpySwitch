+# Nintendo Switch homebrew support. ##########################################
+
+# NXPython reports "nx"; older Python 2 ports reported "horizon".
+switch = sys.platform in ("nx", "horizon")
+
+
+def switch_save_root():
+    """
+    Switch: the writable directory (always ending in "/") where saves, logs,
+    persistent data and regenerated caches live. The launcher (main.c) picks
+    it and passes it in RENPY_SWITCH_SAVE.
+    """
+
+    rv = os.environ.get("RENPY_SWITCH_SAVE", "sdmc:/switch/renpy-saves/default/")
+
+    if not rv.endswith("/"):
+        rv += "/"
+
+    return rv
+
+
+def switch_base():
+    """
+    Switch: the Ren'Py base directory (contains renpy.py and renpy/). Always
+    romfs:/Contents on the console; overridable for desktop simulation.
+    """
+
+    return os.environ.get("RENPY_SWITCH_BASE", "romfs:/Contents")
+
+
+def switch_makedirs(path):
+    try:
+        if not os.path.isdir(path):
+            os.makedirs(path)
+    except Exception:
+        pass
+
+    return path
+
+
