diff --git a/renpy/display/presplash.py b/renpy/display/presplash.py
index be35d80..5629e3b 100644
--- a/renpy/display/presplash.py
+++ b/renpy/display/presplash.py
@@ -264,3 +264,56 @@ def progress(kind, done, total):
     emscripten.run_script(r"""progress(%d, %d);""" % (done, total))
 
     emscripten.sleep(0)
+
+
+def start_switch(gamedir):
+    """
+    Nintendo Switch: show the presplash full-screen while the game loads.
+
+    The window is stored in `window`, so pump_window() keeps it responsive
+    and end() destroys it before the real display is created.
+    """
+
+    global window
+    global progress_bar
+
+    fn = find_file("presplash", root=gamedir)
+
+    if fn is None:
+        fn = find_file("android-presplash", root=gamedir)
+
+    if fn is None:
+        return
+
+    try:
+        pygame.display.init()
+
+        bounds = pygame.display.get_display_bounds(0)
+        bw, bh = bounds[2], bounds[3]
+
+        if not bw or not bh:
+            bw, bh = 1280, 720
+
+        window = pygame.display.Window(sys.argv[0], (bw, bh), flags=pygame.WINDOW_BORDERLESS, pos=(0, 0))
+
+        surface = window.get_surface()
+        surface.fill((0, 0, 0, 255))
+
+        image = pygame.image.load(fn).convert_alpha(surface)
+        iw, ih = image.get_size()
+
+        scale = min(bw / iw, bh / ih)
+        if scale != 1.0:
+            image = pygame.transform.smoothscale(image, (max(1, int(iw * scale)), max(1, int(ih * scale))))
+            iw, ih = image.get_size()
+
+        surface.blit(image, ((bw - iw) // 2, (bh - ih) // 2))
+        window.update()
+
+    except Exception:
+        import traceback
+
+        traceback.print_exc()
+
+        window = None
+        progress_bar = None
diff --git a/renpy/gl2/assimp.py b/renpy/gl2/assimp.py
new file mode 100644
index 0000000..3c3d01e
--- /dev/null
+++ b/renpy/gl2/assimp.py
@@ -0,0 +1,55 @@
+# Nintendo Switch homebrew build: stand-in for the renpy.gl2.assimp Cython
+# module.
+#
+# The real module wraps the Open Asset Importer (assimp) C++ library to load
+# GLTF 3D models. assimp is not available for devkitA64, so on the Switch this
+# pure-Python module provides the same names: the engine hooks become no-ops,
+# and GLTFModel raises a clear error if a game actually tries to show a model.
+# 2D visual novels never touch it.
+#
+# On every other platform the compiled module (assimp.pyx) takes precedence.
+
+import threading
+
+import renpy
+from renpy.display.displayable import Displayable
+
+cache = {}
+predicted = None
+new_predicted = set()
+
+
+def free_memory():
+    cache.clear()
+
+
+class _Loader(object):
+    pass
+
+
+loader = _Loader()
+"The loader used to load in imported models."
+
+loader_lock = threading.Lock()
+"The lock used to protect the loader."
+
+
+class GLTFModel(Displayable):
+    """
+    GLTF models are not supported by the Nintendo Switch homebrew build.
+    """
+
+    def __init__(self, filename, *args, **kwargs):
+        super(GLTFModel, self).__init__(**{k: v for k, v in kwargs.items() if k == "style"})
+        self.filename = filename
+
+    def render(self, width, height, st, at):
+        raise Exception("GLTFModel({!r}): 3D models are not supported on the Nintendo Switch build.".format(self.filename))
+
+
+def finish_predict():
+    pass
+
+
+def preload():
+    pass
